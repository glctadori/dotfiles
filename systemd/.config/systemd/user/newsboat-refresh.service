# Refresh all configured Newsboat feeds; started by newsboat-refresh.timer.
# Requires Newsboat and URLs configured under ~/.config/newsboat.
[Unit]
Description=Refresh Newsboat feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Senza rete (es. subito dopo il resume) salta il giro invece di fallire.
ExecCondition=/usr/bin/nm-online -q -t 30
ExecStart=/usr/bin/newsboat -q -x reload
