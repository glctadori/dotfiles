#!/usr/bin/env bash

set -eu

maildir=${XDG_DATA_HOME:-"$HOME/.local/share"}/mail
 runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
lock="$runtime_dir/mail-sync-$UID.lock"

# isync crea le mailbox, ma richiede la radice di ogni MaildirStore al primo
# avvio.
mkdir -p "$maildir/gmail" "$maildir/mailo" "$maildir/icloud"

if [ "$#" -eq 0 ]; then
    set -- -a
fi

exec 9>"$lock"
if ! flock -n 9; then
    echo "Una sincronizzazione della posta e' gia' in corso." >&2
    exit 0
fi

before=$(find "$maildir" -type f -path '*/new/*' 2>/dev/null | wc -l)

mbsync "$@"
notmuch new >/dev/null

after=$(find "$maildir" -type f -path '*/new/*' 2>/dev/null | wc -l)
new=$((after - before))

if [ "$new" -gt 0 ] && command -v notify-send >/dev/null 2>&1; then
    notify-send "Mail" "$new nuova/e email"
fi
