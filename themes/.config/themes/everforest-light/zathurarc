# Everforest Light Medium — Zathura

# Base
set default-bg "#fdf6e3"
set default-fg "#5c6a72"

# Statusbar
set statusbar-bg "#f4f0d9"
set statusbar-fg "#5c6a72"

# Inputbar
set inputbar-bg "#f4f0d9"
set inputbar-fg "#3a94c5"

# Completion
set completion-bg "#f4f0d9"
set completion-fg "#5c6a72"
set completion-highlight-bg "#3a94c5"
set completion-highlight-fg "#fdf6e3"

# Notifications
set notification-bg "#3a94c5"
set notification-fg "#fdf6e3"

set notification-error-bg "#f85552"
set notification-error-fg "#fdf6e3"

set notification-warning-bg "#dfa000"
set notification-warning-fg "#fdf6e3"

# PDF recoloring
set recolor true
set recolor-darkcolor "#5c6a72"
set recolor-lightcolor "#fdf6e3"
set recolor-keephue true
set recolor-reverse-video true

# Loading
set render-loading true
set render-loading-bg "#fdf6e3"
set render-loading-fg "#5c6a72"
