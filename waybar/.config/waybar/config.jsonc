{
    "layer": "top",
    "position": "top",
    "height": 26,

    "modules-left": [
        "hyprland/workspaces",
        "mpd"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "custom/pomodoro",
        "custom/idle",
        "custom/claude",
        // nascosti, non eliminati: "custom/codex", "custom/openrouter",
        "network",
        "pulseaudio",
        "battery",
        "clock"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 70
    },

    "custom/idle": {
        "exec": "~/.local/bin/waybar-idle",
        "return-type": "json",
        "signal": 9,
        "interval": 30,
        "on-click": "~/.local/bin/idle-toggle"
    },

    "custom/pomodoro": {
        "exec": "~/.local/bin/waybar-pomodoro",
        "return-type": "json",
        "signal": 10,
        "interval": 1,
        "on-click": "~/.local/bin/pomodoro"
    },

    "custom/claude": {
        "exec": "~/.local/bin/waybar-claude",
        "return-type": "json",
        "interval": 120,
        "tooltip": true
    },

    "custom/codex": {
        "exec": "~/.local/bin/waybar-codex",
        "return-type": "json",
        "format": "Codex {}",
        "interval": 60,
        "tooltip": true
    },

    "custom/openrouter": {
        "exec": "~/.local/bin/waybar-openrouter",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },

    "mpd": {
        "format": "{stateIcon} {artist} — {title}",
        "format-stopped": "󰝛 MPD",
        "format-disconnected": "󰝛 MPD",
        "state-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        },
        "max-length": 45,
        "tooltip-format": "{artist} — {album}\n{title}  {elapsedTime:%M:%S}/{totalTime:%M:%S}"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", ""]
        }
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
            "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ]
    },

    "clock": {
        "format": "{:%d/%m  %H:%M}"
    }
}
