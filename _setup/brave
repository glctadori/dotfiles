#!/usr/bin/env bash

set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"

POLICY_SOURCE="$CONFIG_ROOT/brave/policies/minimal.json"
POLICY_DIR="/etc/brave/policies/managed"
POLICY_DEST="$POLICY_DIR/dotfiles-minimal.json"

install_brave() {
    echo "Setting up Brave..."

    # ── Repository e pacchetto ───────────────────────────────────────
    if ! command -v brave-browser >/dev/null 2>&1; then
        sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
            https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
        sudo tee /etc/apt/sources.list.d/brave-browser-release.sources >/dev/null <<'EOF2'
Types: deb
URIs: https://brave-browser-apt-release.s3.brave.com
Suites: stable
Components: main
Architectures: amd64 arm64
Signed-By: /usr/share/keyrings/brave-browser-archive-keyring.gpg
EOF2
        sudo apt update
        sudo apt install -y brave-browser
    fi

    # ── Validate policy ──────────────────────────────────────────────
    if [[ ! -r "$POLICY_SOURCE" ]]; then
        echo "Policy not found: $POLICY_SOURCE" >&2
        exit 1
    fi

    if ! jq empty "$POLICY_SOURCE"; then
        echo "Invalid JSON: $POLICY_SOURCE" >&2
        exit 1
    fi

    # ── Install policy ───────────────────────────────────────────────
    sudo install -D -m 0644 \
        "$POLICY_SOURCE" \
        "$POLICY_DEST"


    echo
    echo "Brave configured."
    echo "Policy: $POLICY_DEST"
    echo
    echo "Restart Brave and check brave://policy"
}

remove_brave() {
    echo "Removing Brave setup..."

    # ── Remove policy ────────────────────────────────────────────────
    sudo rm -f "$POLICY_DEST"


    echo "Brave setup removed."
    echo "Restart Brave."
}

case "${1:-install}" in
    install)
        install_brave
        ;;

    remove)
        remove_brave
        ;;

    *)
        echo "Usage: _setup/brave [install|remove]" >&2
        exit 2
        ;;
esac
