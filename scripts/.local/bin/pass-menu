#!/usr/bin/env bash

store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

entry="$(
    find "$store" -type f -name '*.gpg' -printf '%P\n' |
    sed 's/\.gpg$//' |
    sort |
    fuzzel --dmenu --prompt="Password: "
)"

[[ -z "$entry" ]] && exit 0

data="$(pass show "$entry")"

password="$(printf '%s\n' "$data" | sed -n '1p')"
login="$(printf '%s\n' "$data" | sed -n '2p')"

# Clear the clipboard after 45 s, but only if it still holds this password.
printf '%s' "$password" | wl-copy
(
    sleep 45
    [[ "$(wl-paste --no-newline 2>/dev/null)" == "$password" ]] && wl-copy --clear
) >/dev/null 2>&1 &
disown

notify-send \
    "Password copied" \
    "$entry\n$login"
