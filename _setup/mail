#!/bin/sh
# Generate private mail identity configuration from pass entries.
# Usage: mail-setup; requires pass and a GPG agent (or gpg key) already set up.
#
# pass entry layout (one entry per account, two lines):
#   line 1 = password (or app-password)
#   line 2 = login (email address)
#
#   login/mailo.com            -> mailo
#   app-password/gmail/neomutt -> gmail
#   app-password/icloud/neomutt -> icloud
set -eu

config=${XDG_CONFIG_HOME:-"$HOME/.config"}
data=${XDG_DATA_HOME:-"$HOME/.local/share"}
mkdir -p "$config/neomutt/accounts" "$config/msmtp" "$data/mail" "$config/abook"

# pass entry name for each account.
pass_entry() {
  case $1 in
    gmail)  printf '%s\n' 'app-password/gmail/neomutt' ;;
    icloud) printf '%s\n' 'app-password/icloud/neomutt' ;;
    mailo)  printf '%s\n' 'login/mailo.com' ;;
  esac
}

# Read one field from a pass entry: 1 = password, 2 = login.
pass_field() {
  account=$1 lineno=$2
  entry=$(pass_entry "$account")
  if ! value=$(pass show "$entry" 2>/dev/null | sed -n "${lineno}p") || [ -z "$value" ]; then
    printf 'mail-setup: entry %s manca la riga %s in pass\n' "$entry" "$lineno" >&2
    exit 1
  fi
  printf '%s\n' "$value"
}

gmail=$(pass_field gmail 2)
mailo=$(pass_field mailo 2)
icloud=$(pass_field icloud 2)

# Login usernames are email addresses and are also used as sender addresses.
for address in "$gmail" "$mailo" "$icloud"; do
  case $address in *@*.*) ;; *) printf '%s\n' 'A pass mail entry has no valid login on line 2' >&2; exit 1 ;; esac
done

# Fail early if any password (line 1) is missing, so we don't write broken configs.
for account in gmail mailo icloud; do
  pass_field "$account" 1 >/dev/null
done

fullname=$(getent passwd "$USER" 2>/dev/null | cut -d: -f5 | cut -d, -f1)
[ -n "$fullname" ] || fullname=$USER
mutt_name=$(printf '%s' "$fullname" | sed 's/["\\]/\\&/g')

write_account() {
  account=$1 address=$2 record=$3 postponed=$4 trash=$5 status=$6 boxes=$7
  cat >"$config/neomutt/accounts/$account" <<EOF
# Generated by mail-setup; edit the generator rather than this private file.
set folder = "~/.local/share/mail/$account"
set spoolfile = "+INBOX"
set record = "$record"
set postponed = "$postponed"
set trash = "$trash"
set from = "$address"
set realname = "$mutt_name"
set status_format = " $status  │  %D  %<u? %u  >%m messaggi%<F?   %F>%> %P "
set sendmail = "/usr/bin/msmtp -a $account"
set use_from = yes
set envelope_from = yes
$boxes
macro index,pager o "<shell-escape>mail-sync $account<enter>" "Sincronizza $status"
macro index M "<shell-escape>neomutt-action $account<enter><enter-command>source ~/.cache/neomutt/action.rc<enter>" "Azioni sulle mail selezionate"
macro index J "<shell-escape>neomutt-folder $account<enter><enter-command>source ~/.cache/neomutt/folder.rc<enter>" "Apri cartella con fzf"
EOF
}

write_account gmail "$gmail" '+[Gmail]/Posta inviata' '+[Gmail]/Bozze' '+[Gmail]/Cestino' Gmail 'named-mailboxes "  Inbox" +INBOX "  Archivio" "+[Gmail]/Tutti i messaggi" "  Bozze" "+[Gmail]/Bozze" "  Inviate" "+[Gmail]/Posta inviata" "  Cestino" "+[Gmail]/Cestino" "  Spam" "+[Gmail]/Spam"'
write_account mailo "$mailo" '+sent' '+draftbox' '+trash' Mailo 'named-mailboxes "  Inbox" +INBOX "  Archivio" +Archive "  Bozze" +draftbox "  Inviate" +sent "  Cestino" +trash "  Spam" +unsolbox'
write_account icloud "$icloud" '+Sent Messages' '+Drafts' '+Deleted Messages' iCloud 'named-mailboxes "  Inbox" +INBOX "  Archivio" +Archive "  Bozze" +Drafts "  Inviate" "+Sent Messages" "  Cestino" "+Deleted Messages" "  Spam" +Junk'

cat >"$config/isyncrc" <<EOF
# Generated by mail-setup. Passwords are read from pass at runtime (line 1).
IMAPAccount mailo
Host mail.mailo.com
Port 993
User $mailo
PassCmd "pass show $(pass_entry mailo) | sed -n 1p"
TLSType IMAPS

IMAPStore mailo-remote
Account mailo

MaildirStore mailo-local
SubFolders Verbatim
Path $data/mail/mailo/
Inbox $data/mail/mailo/INBOX

Channel mailo
Far :mailo-remote:
Near :mailo-local:
Patterns *
Create Both
Expunge Both
SyncState *

IMAPAccount icloud
Host imap.mail.me.com
Port 993
User $icloud
PassCmd "pass show $(pass_entry icloud) | sed -n 1p"
TLSType IMAPS

IMAPStore icloud-remote
Account icloud

MaildirStore icloud-local
SubFolders Verbatim
Path $data/mail/icloud/
Inbox $data/mail/icloud/INBOX

Channel icloud
Far :icloud-remote:
Near :icloud-local:
Patterns *
Create Both
Expunge Both
SyncState *

IMAPAccount gmail
Host imap.gmail.com
Port 993
User $gmail
PassCmd "pass show $(pass_entry gmail) | sed -n 1p"
TLSType IMAPS

IMAPStore gmail-remote
Account gmail

MaildirStore gmail-local
SubFolders Verbatim
Path $data/mail/gmail/
Inbox $data/mail/gmail/INBOX

Channel gmail
Far :gmail-remote:
Near :gmail-local:
Patterns *
Create Both
Expunge Both
SyncState *
EOF

cat >"$config/msmtp/config" <<EOF
# Generated by mail-setup. Passwords are read from pass at runtime (line 1).
defaults
auth on
tls on
tls_starttls off

account mailo
host mail.mailo.com
port 465
from $mailo
user $mailo
passwordeval "pass show $(pass_entry mailo) | sed -n 1p"

account icloud
tls_starttls on
host smtp.mail.me.com
port 587
from $icloud
user $icloud
passwordeval "pass show $(pass_entry icloud) | sed -n 1p"

account gmail
tls_starttls on
host smtp.gmail.com
port 587
from $gmail
user $gmail
passwordeval "pass show $(pass_entry gmail) | sed -n 1p"

account default : gmail
EOF

cat >"$HOME/.notmuch-config" <<EOF
# Generated by mail-setup.
[database]
path=$data/mail
[user]
name=$fullname
primary_email=$gmail
other_email=$mailo;$icloud
[new]
tags=unread;inbox;
ignore=.mbsyncstate;.uidvalidity
[search]
exclude_tags=deleted;
[maildir]
synchronize_flags=true
EOF
printf '%s\n' "$fullname" >"$config/neomutt/signature"
chmod 600 "$config/isyncrc" "$config/msmtp/config" "$HOME/.notmuch-config" "$config/neomutt/signature" "$config/neomutt/accounts/"*
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now mbsync.timer
fi
printf '%s\n' 'Mail configuration generated and periodic synchronization enabled. Run: mail-sync'
