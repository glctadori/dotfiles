#!/usr/bin/env bash
set -euo pipefail

notify() {
    # Le chiamate automatiche (hotplug) restano silenziose finché va tutto bene.
    [[ -n "${DISPLAY_MONITOR_QUIET:-}" && "${2:-normal}" != critical ]] && return 0
    notify-send -a display-monitor -h string:x-canonical-private-synchronous:display-monitor \
        -u "${2:-normal}" -t 4000 "Schermi · Mod+F2" "$1" >/dev/null 2>&1 || true
}

trap 'notify "Impossibile configurare gli schermi. Riprova Mod+F2." critical' ERR
notify "Comando ricevuto: controllo i monitor…"

# Una pressione ripetuta non deve sovrapporre le riconfigurazioni.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/display-monitor-${UID}.lock"
flock -w 10 9 || { notify "Configurazione schermi già in corso."; exit 0; }

# Regole lette da hyprland.conf: sopravvivono a `hyprctl reload` (cambio tema).
# .zprofile lo svuota a ogni login, così il pannello parte sempre acceso.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/monitors.conf"
mkdir -p "$(dirname "$STATE")"

# Include i pannelli disabilitati, per poterli ripristinare.
MONITORS="$(hyprctl monitors all -j)"
INTERNAL="$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // empty' <<< "$MONITORS")"
EXTERNAL="$(jq -r '[.[] | select(.name | test("^(HDMI|DP|DVI|VGA|USB-C)-"))][0].name // empty' <<< "$MONITORS")"

if [[ -z "$INTERNAL" ]]; then
    notify "Nessun pannello laptop trovato." critical
    echo "Nessun pannello laptop trovato." >&2
    exit 1
fi

if [[ -n "$EXTERNAL" ]]; then
    # Pannello disattivato, non in mirror: i client vedono un solo output a scala 1
    # e ridisegnano tutto (il mirror lasciava buffer a metà alla scala 1.25).
    RULES="monitor=$EXTERNAL,preferred,auto,1
monitor=$INTERNAL,disable"
    TARGET="$EXTERNAL"
    MESSAGE="Monitor esterno $EXTERNAL attivo. Schermo laptop spento."
else
    RULES="monitor=$INTERNAL,preferred,auto,1.25"
    TARGET="$INTERNAL"
    MESSAGE="Nessun monitor esterno collegato. Schermo laptop acceso."
fi

if [[ -n "${DISPLAY_MONITOR_QUIET:-}" && -f "$STATE" && "$(cat "$STATE")" == "$RULES" ]]; then
    # Hotplug generato dalla nostra stessa riconfigurazione: niente da fare.
    exit 0
fi

ACTIVE_WORKSPACE="$(hyprctl activeworkspace -j | jq -r '.id')"

printf '%s\n' "$RULES" > "$STATE"
hyprctl reload >/dev/null

# Le regole vengono applicate in modo asincrono: aspetta che l'output esista.
for _ in $(seq 20); do
    hyprctl monitors -j | jq -e --arg m "$TARGET" 'any(.[]; .name == $m)' >/dev/null && break
    sleep 0.1
done

hyprctl dispatch dpms on "$TARGET" >/dev/null
while IFS= read -r workspace; do
    hyprctl dispatch moveworkspacetomonitor "$workspace $TARGET" >/dev/null
done < <(hyprctl workspaces -j | jq -r --arg target "$TARGET" '.[] | select(.monitor != $target) | if .id > 0 then (.id | tostring) else "name:" + .name end')
hyprctl dispatch focusmonitor "$TARGET" >/dev/null
if [[ "$ACTIVE_WORKSPACE" -gt 0 ]]; then
    hyprctl dispatch workspace "$ACTIVE_WORKSPACE" >/dev/null
fi

# Sfondo sul nuovo output e ridisegno completo (prima serviva uno screenshot).
hyprctl hyprpaper wallpaper ",$(readlink -f "$HOME/.config/themes/current/wallpaper.png")" >/dev/null 2>&1 || true
pkill -SIGUSR2 -x waybar || true
hyprctl dispatch forcerendererreload >/dev/null

notify "$MESSAGE"
