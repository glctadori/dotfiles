#!/usr/bin/env python3
"""Extract PDF page ranges in list order using qpdf."""

import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


class ComposeError(Exception):
    pass


def qpdf(*arguments):
    result = subprocess.run(
        ["qpdf", *map(str, arguments)], capture_output=True, text=True
    )
    if result.returncode not in (0, 3):
        raise ComposeError(result.stderr.strip() or "qpdf non ha completato l'operazione")
    if result.stderr.strip():
        print(result.stderr.strip(), file=sys.stderr)
    return result.stdout.strip()


def read_selection(list_path, books_dir):
    selections = []
    page_counts = {}
    for number, line in enumerate(list_path.read_text(encoding="utf-8").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            if line.count("|") != 1:
                raise ComposeError("formato richiesto: libro.pdf | 12-28,35")
            filename, ranges_text = (part.strip() for part in line.split("|"))
            if not filename or not ranges_text:
                raise ComposeError("nome file e pagine sono obbligatori")
            source = Path(filename).expanduser()
            if not source.is_absolute():
                source = books_dir / source
            source = source.resolve()
            if not source.is_file():
                raise ComposeError(f"file non trovato: {source}")
            if source not in page_counts:
                page_counts[source] = int(qpdf(source, "--show-npages"))
            normalized = []
            selected_count = 0
            for interval in ranges_text.split(","):
                match = re.fullmatch(r"([1-9][0-9]*)(?:\s*-\s*([1-9][0-9]*))?", interval.strip())
                if not match:
                    raise ComposeError(f"intervallo non valido: {interval.strip()!r}")
                start = int(match[1])
                end = int(match[2]) if match[2] else start
                if start > end:
                    raise ComposeError(f"intervallo invertito: {start}-{end}")
                if end > page_counts[source]:
                    raise ComposeError(f"pagina {end} oltre le {page_counts[source]} pagine di {source.name}")
                normalized.append(f"{start}-{end}" if match[2] else str(start))
                selected_count += end - start + 1
            selections.append((number, source, ",".join(normalized), selected_count))
        except (ComposeError, OSError, ValueError) as error:
            raise ComposeError(f"riga {number}: {error}") from error
    if not selections:
        raise ComposeError("la lista non contiene estratti")
    return selections


def main():
    parser = argparse.ArgumentParser(
        description="Unisce estratti nell'ordine della lista. Pagine fisiche del PDF, contando da 1."
    )
    parser.add_argument("list", type=Path, help="lista UTF-8: libro.pdf | 12-28,35")
    parser.add_argument("output", type=Path, help="nuovo PDF da creare (non sovrascrive)")
    parser.add_argument("--books-dir", type=Path, default=Path.home() / "docs/library",
                        help="cartella dei sorgenti (default: ~/docs/library)")
    parser.add_argument("--dry-run", action="store_true", help="verifica e mostra la selezione senza scrivere")
    args = parser.parse_args()
    try:
        if not shutil.which("qpdf"):
            raise ComposeError("comando mancante: qpdf")
        output = args.output.expanduser().absolute()
        if os.path.lexists(output):
            raise ComposeError(f"destinazione già esistente: {output}")
        if not output.parent.is_dir():
            raise ComposeError(f"cartella di destinazione non trovata: {output.parent}")
        selections = read_selection(args.list.expanduser(), args.books_dir.expanduser())
        expected_pages = sum(item[3] for item in selections)
        summary_stream = sys.stdout if args.dry_run else sys.stderr
        for number, source, ranges, count in selections:
            print(f"Riga {number}: {source} | {ranges} ({count} pagine)", file=summary_stream)
        print(f"Totale: {expected_pages} pagine → {output}", file=summary_stream)
        if args.dry_run:
            return 0
        with tempfile.TemporaryDirectory(prefix=".pdf-compose-", dir=output.parent) as work:
            temporary_pdf = Path(work) / "document.pdf"
            arguments = ["--empty", "--pages"]
            for _, source, ranges, _ in selections:
                arguments.extend([str(source), ranges])
            qpdf(*arguments, "--", temporary_pdf)
            qpdf(temporary_pdf, "--check")
            actual_pages = int(qpdf(temporary_pdf, "--show-npages"))
            if actual_pages != expected_pages:
                raise ComposeError(f"totale inatteso: {actual_pages} invece di {expected_pages}")
            # Publish without overwriting, even if another process creates output meanwhile.
            os.link(temporary_pdf, output)
        print(output)
        return 0
    except (ComposeError, OSError, ValueError) as error:
        print(f"Errore: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
