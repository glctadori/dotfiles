#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

run() {
    echo
    echo "==> $1"
    shift
    "$@"
}

# Base system first: installs stow and the packages needed by the dotfiles.
run "Base system" "$ROOT/_setup/base"

# Every top-level directory tracked by git is a Stow package: untracked ones
# (node_modules, tool stubs) never reach $HOME.
# Directories beginning with '_' are repository internals and are ignored.
echo
echo "==> Stowing dotfiles"
for package in $(git -C "$ROOT" ls-files | awk -F/ 'NF > 1 { print $1 }' | sort -u); do
    [[ "$package" == _* ]] && continue
    echo "  -> $package"
    stow --restow --target="$HOME" "$package"
done

# Theme selected by `theme`; not versioned, so a fresh clone needs a default.
[[ -e "$ROOT/themes/.config/themes/current" ]] ||
    ln -s everforest-dark "$ROOT/themes/.config/themes/current"

# Setup that depends on the dotfiles now being in place.
run "Desktop"  "$ROOT/_setup/desktop"
run "Laptop"   "$ROOT/_setup/laptop"
run "Network"  "$ROOT/_setup/network"
run "Fonts"    "$ROOT/_setup/fonts"
run "Development tools" "$ROOT/_setup/dev"
run "Brave"    "$ROOT/_setup/brave"
run "Mail"     "$ROOT/_setup/mail"
run "Printer"     "$ROOT/_setup/printer"

echo
echo "Bootstrap complete."
echo "Optional: _setup/autologin, _setup/plymouth, _setup/ros"
