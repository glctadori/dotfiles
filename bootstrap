#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

run() {
    echo
    echo "==> $1"
    shift
    "$@"
}

# Base system first: installs stow and the packages needed by the dotfiles.
run "Base system" "$ROOT/_setup/base"

# Every normal top-level directory is a Stow package.
# Directories beginning with '_' are repository internals and are ignored.
echo
echo "==> Stowing dotfiles"
for dir in */; do
    package="${dir%/}"
    [[ "$package" == _* ]] && continue
    echo "  -> $package"
    stow --restow --target="$HOME" "$package"
done

# Setup that depends on the dotfiles now being in place.
run "Desktop"  "$ROOT/_setup/desktop"
run "Laptop"   "$ROOT/_setup/laptop"
run "Network"  "$ROOT/_setup/network"
run "Fonts"    "$ROOT/_setup/fonts"
run "Development tools" "$ROOT/_setup/dev"
run "Brave"    "$ROOT/_setup/brave"
run "Mail"     "$ROOT/_setup/mail"

echo
echo "Bootstrap complete."
echo "Optional: _setup/plymouth, _setup/ros"
