#!/usr/bin/python3 -I
"""Send embedding inputs to the local broker; no credential access."""

import json
import socket
import sys

SOCKET = "/run/agent-embeddings/socket"
MAX_REQUEST = 2 * 1024 * 1024
MAX_RESPONSE = 32 * 1024 * 1024


def main():
    request = sys.stdin.buffer.read(MAX_REQUEST + 1)
    if len(request) > MAX_REQUEST:
        raise SystemExit("error: embedding request is too large")
    try:
        payload = json.loads(request)
    except (ValueError, UnicodeError):
        raise SystemExit("error: invalid embedding request") from None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(150)
            connection.connect(SOCKET)
            connection.sendall(json.dumps(payload).encode() + b"\n")
            with connection.makefile("rb") as stream:
                response = stream.readline(MAX_RESPONSE + 1)
        if len(response) > MAX_RESPONSE or not response.endswith(b"\n"):
            raise ValueError
        result = json.loads(response)
        if "error" in result:
            raise SystemExit("error: " + result["error"])
        print(json.dumps(result, allow_nan=False))
    except FileNotFoundError:
        raise SystemExit("error: embedding service is not installed; run _setup/setup-agent-secrets outside the agent") from None
    except (OSError, ValueError, TypeError):
        raise SystemExit("error: embedding service is unavailable or returned an invalid response") from None


if __name__ == "__main__":
    main()
