#!/usr/bin/env bash

set -u

# Aspetta che Hyprland/PipeWire abbiano registrato il nuovo hardware.
sleep 0.5

# ── VIDEO ────────────────────────────────────────────────

# Usa la stessa configurazione e lo stesso lock del comando F2.
"$(dirname "$0")/display-monitor" || exit $?


# ── AUDIO ────────────────────────────────────────────────

sleep 0.5

# Trova automaticamente un sink digitale HDMI/DisplayPort.
HDMI_SINK="$(
    wpctl status -n |
        awk '
            /Sinks:/ {sinks=1; next}
            /Sources:/ {sinks=0}
            sinks && tolower($0) ~ /(hdmi|displayport)/ {
                gsub(/[.*]/, "", $1)
                print $1
                exit
            }
        '
)"

if [[ -n "$HDMI_SINK" ]]; then
    wpctl set-default "$HDMI_SINK"
else
    # Nessun HDMI: scegli automaticamente il sink analogico disponibile.
    ANALOG_SINK="$(
        wpctl status -n |
            awk '
                /Sinks:/ {sinks=1; next}
                /Sources:/ {sinks=0}
                sinks && tolower($0) ~ /(analog|speaker)/ {
                    gsub(/[.*]/, "", $1)
                    print $1
                    exit
                }
            '
    )"

    [[ -n "$ANALOG_SINK" ]] && wpctl set-default "$ANALOG_SINK"
fi
