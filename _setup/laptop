#!/usr/bin/env bash
set -euo pipefail

sudo usermod -aG video "$USER"
sudo systemctl enable --now tlp.service thermald.service

sudo sed -i \
  '/^[[:space:]#]*START_CHARGE_THRESH_BAT1=/d;
   /^[[:space:]#]*STOP_CHARGE_THRESH_BAT1=/d;
   /^[[:space:]#]*USB_AUTOSUSPEND=/d' /etc/tlp.conf
printf '\nSTART_CHARGE_THRESH_BAT1=75\nSTOP_CHARGE_THRESH_BAT1=80\nUSB_AUTOSUSPEND=0\n' | \
    sudo tee -a /etc/tlp.conf >/dev/null
sudo tlp start

# Avviso batteria bassa e sospensione al 5%: sotto quella soglia il dock non
# riesce più a ricaricare la batteria.
systemctl --user enable --now battery-alert.timer

# Niente wake da USB: col dock collegato il portatile si risvegliava dopo pochi
# secondi da ogni suspend. Si sveglia con il tasto power o aprendo il coperchio.
sudo rm -f /etc/udev/rules.d/90-usb-wakeup.rules /etc/udev/rules.d/90-usb-wakeup.rules.disabled

# Il kernel registra cosa risveglia dal suspend; `suspend-report` lo riassume.
echo 'w /sys/power/pm_debug_messages - - - - 1' | sudo tee /etc/tmpfiles.d/pm-debug.conf >/dev/null
sudo systemd-tmpfiles --create /etc/tmpfiles.d/pm-debug.conf

# Hotspot iPhone via USB: dopo un suspend l'iPhone si ricollega e usbmuxd lo
# perde, quindi niente Ethernet e richiesta "Autorizza" sul telefono.
# Lo riavvia solo dopo il resume, a verifica dell'abbinamento conclusa: un riavvio
# durante la verifica (vecchia regola udev a ogni collegamento) cancellava l'abbinamento.
sudo rm -f /etc/udev/rules.d/90-iphone-usbmuxd.rules
sudo udevadm control --reload-rules
sudo tee /etc/systemd/system/usbmuxd-resume.service >/dev/null <<'EOF2'
[Unit]
Description=Riavvia usbmuxd dopo il resume (hotspot iPhone via USB)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 10
ExecStart=/usr/bin/systemctl try-restart usbmuxd.service

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
EOF2
sudo systemctl daemon-reload
sudo systemctl enable usbmuxd-resume.service
