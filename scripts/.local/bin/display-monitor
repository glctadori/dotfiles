#!/usr/bin/env bash
set -euo pipefail

notify() {
    notify-send -a display-monitor -h string:x-canonical-private-synchronous:display-monitor \
        -u "${2:-normal}" -t 4000 "Schermi · Mod+F2" "$1" >/dev/null 2>&1 || true
}

trap 'notify "Impossibile configurare gli schermi. Riprova Mod+F2." critical' ERR
notify "Comando ricevuto: controllo i monitor…"

# Una pressione ripetuta non deve sovrapporre le riconfigurazioni.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/display-monitor-${UID}.lock"
flock -w 10 9 || { notify "Configurazione schermi già in corso."; exit 0; }

# Include i pannelli disabilitati, per poterli ripristinare.
MONITORS="$(hyprctl monitors all -j)"
INTERNAL="$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // empty' <<< "$MONITORS")"
EXTERNAL="$(jq -r '[.[] | select(.name | test("^(HDMI|DP|DVI|VGA|USB-C)-"))][0].name // empty' <<< "$MONITORS")"

if [[ -z "$INTERNAL" ]]; then
    notify "Nessun pannello laptop trovato." critical
    echo "Nessun pannello laptop trovato." >&2
    exit 1
fi

ACTIVE_WORKSPACE="$(hyprctl activeworkspace -j | jq -r '.id')"
move_workspaces() {
    local target="$1" workspace
    while IFS= read -r workspace; do
        hyprctl dispatch moveworkspacetomonitor "$workspace $target"
    done < <(hyprctl workspaces -j | jq -r --arg target "$target" '.[] | select(.monitor != $target) | if .id > 0 then (.id | tostring) else "name:" + .name end')
    hyprctl dispatch focusmonitor "$target"
    if [[ "$ACTIVE_WORKSPACE" -gt 0 && "$(hyprctl activeworkspace -j | jq -r '.id')" != "$ACTIVE_WORKSPACE" ]]; then
        hyprctl dispatch workspace "$ACTIVE_WORKSPACE"
    fi
}

if [[ -n "$EXTERNAL" ]]; then
    # L'esterno è la sorgente: resta attivo anche a pannello laptop spento.
    hyprctl keyword monitor "$EXTERNAL,preferred,auto,1"
    hyprctl dispatch dpms on "$EXTERNAL"
    # Migra anche i workspace nascosti prima di togliere il laptop dal desktop.
    move_workspaces "$EXTERNAL"
    hyprctl keyword monitor "$INTERNAL,preferred,auto,1,mirror,$EXTERNAL"
    # DPMS spegne il pannello senza rimuovere la configurazione mirror.
    hyprctl dispatch dpms off "$INTERNAL"
    notify "Monitor esterno $EXTERNAL attivo in mirror. Schermo laptop spento."
else
    # Rimuove il mirror e ripristina la scala abituale del laptop.
    hyprctl keyword monitor "$INTERNAL,preferred,auto,1.25"
    hyprctl dispatch dpms on "$INTERNAL"
    move_workspaces "$INTERNAL"
    # Hyprland può lasciare l'output senza eventi dopo la rimozione del mirror.
    if pgrep -x waybar >/dev/null; then
        sleep 0.3
        if ! hyprctl layers -j | jq -e --arg output "$INTERNAL" '.[$output].levels[][] | select(.namespace == "waybar")' >/dev/null; then
            hyprctl keyword monitor "$INTERNAL,disable"
            sleep 1
            hyprctl keyword monitor "$INTERNAL,preferred,auto,1.25"
        fi
        pkill -SIGUSR2 -x waybar || true
    fi
    notify "Nessun monitor esterno collegato. Schermo laptop acceso."
fi
