#!/usr/bin/env python3
"""Quota Claude (sessione 5h e settimanale) per Waybar, tramite endpoint OAuth usage."""
import datetime
import json
from pathlib import Path
import urllib.request

ICON = '󰧑'  # nf-md-brain


def fetch():
    creds = json.loads((Path.home() / '.claude/.credentials.json').read_text())
    token = creds['claudeAiOauth']['accessToken']
    request = urllib.request.Request(
        'https://api.anthropic.com/api/oauth/usage',
        headers={'Authorization': f'Bearer {token}', 'anthropic-beta': 'oauth-2025-04-20'},
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def render(data):
    values = []
    tooltip = ['Claude · quota rimanente']
    for key, label in (('five_hour', 'Sessione 5 ore'), ('seven_day', 'Settimanale')):
        window = data.get(key)
        if not window or window.get('utilization') is None:
            continue
        remaining = max(0, min(100, 100 - float(window['utilization'])))
        values.append(int(remaining))
        tooltip.append(f'{label}: {remaining:g}% disponibile')
        if window.get('resets_at'):
            reset = datetime.datetime.fromisoformat(window['resets_at']).astimezone()
            tooltip.append(f'  Reset: {reset:%d/%m %H:%M}')
    if not values:
        raise ValueError('Nessuna quota disponibile')
    lowest = min(values)
    return {
        'text': f'{ICON} ' + ' / '.join(f'{v}%' for v in values),
        'tooltip': '\n'.join(tooltip), 'percentage': lowest,
        'class': 'critical' if lowest <= 10 else 'warning' if lowest <= 25 else 'normal',
    }


if __name__ == '__main__':
    try:
        output = render(fetch())
    except Exception:
        # Testo vuoto: Waybar nasconde il modulo quando la quota non è disponibile.
        output = {'text': '', 'tooltip': '', 'class': 'unavailable'}
    print(json.dumps(output, ensure_ascii=False))
