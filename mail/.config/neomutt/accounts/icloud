# Generated by mail-setup; edit the generator rather than this private file.
set folder = "~/.local/share/mail/icloud"
set spoolfile = "+INBOX"
set record = "+Sent Messages"
set postponed = "+Drafts"
set trash = "+Deleted Messages"
set from = "g.tadori@icloud.com"
set realname = "gian"
set status_format = " iCloud  │  %D  %<u? %u  >%m messaggi%<F?   %F>%> %P "
set sendmail = "/usr/bin/msmtp -a icloud"
set use_from = yes
set envelope_from = yes
named-mailboxes "  Inbox" +INBOX "  Archivio" +Archive "  Bozze" +Drafts "  Inviate" +Sent Messages "  Cestino" +Deleted Messages "  Spam" +Junk
macro index,pager o "<shell-escape>mail-sync icloud<enter>" "Sincronizza iCloud"
macro index M "<shell-escape>neomutt-action icloud<enter><enter-command>source ~/.cache/neomutt/action.rc<enter>" "Azioni sulle mail selezionate"
macro index J "<shell-escape>neomutt-folder icloud<enter><enter-command>source ~/.cache/neomutt/folder.rc<enter>" "Apri cartella con fzf"
