#!/usr/bin/python3 -I
"""Install the embeddings broker and provision its credential."""

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys


def install_link(source, destination):
    if destination.is_symlink():
        destination.unlink()
    elif destination.exists():
        raise SystemExit(f"refusing to replace regular file: {destination}")
    destination.symlink_to(source)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rotate-key", action="store_true", help="reimport api/openrouter from pass")
    args = parser.parse_args()
    if os.getuid() == 0:
        raise SystemExit("run as your normal user; the script invokes sudo for installation")
    for name in ("sudo", "pass", "systemctl"):
        if not shutil.which(name):
            raise SystemExit(f"missing dependency: {name}")
    root = Path(__file__).resolve().parent.parent
    home = Path.home()
    targets = {home / ".local/bin" / name: root / "scripts/.local/bin" / name
               for name in ("agent-embeddings",)}
    for target in targets:
        if target.exists() and not target.is_symlink():
            raise SystemExit(f"refusing to replace regular file: {target}")
    command = ["sudo", "/usr/bin/python3", "-I", str(root / "_setup/agent-secrets/install.py"),
               "--uid", str(os.getuid()), "--gid", str(os.getgid())]
    # Obtain sudo authorization before holding a plaintext credential in memory.
    subprocess.run(["sudo", "-v"], check=True)
    key = None
    if args.rotate_key or not Path("/etc/agent-secrets/openrouter").exists():
        result = subprocess.run(["pass", "show", "api/openrouter"], capture_output=True)
        if result.returncode or not result.stdout.splitlines():
            raise SystemExit("cannot read api/openrouter from pass; unlock GPG outside the agent and retry")
        key = result.stdout.splitlines()[0].strip()
        if not key:
            raise SystemExit("empty api/openrouter credential")
        command.append("--credential")
    subprocess.run(command, input=key, check=True)
    (home / ".local/bin").mkdir(parents=True, exist_ok=True)
    for target, source in targets.items():
        install_link(source, target)
    print("Embeddings broker installed.")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError:
        sys.exit("setup failed")
    except KeyboardInterrupt:
        sys.exit("setup interrupted")
