{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.password-store", "~/.gnupg"],
      "allowManagedReadPathsOnly": true
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.password-store/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.password-store/**)",
      "Edit(~/.gnupg/**)"
    ]
  }
}
