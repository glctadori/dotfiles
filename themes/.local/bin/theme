#!/usr/bin/env bash
set -e
THEMES="$HOME/.config/themes"
THEME="${1:-}"

if [[ -z "$THEME" ]]; then
    basename "$(readlink -f "$THEMES/current")"
    exit
fi

if [[ ! -d "$THEMES/$THEME" ]]; then
    echo "Theme not found: $THEME"
    echo
    echo "Available:"
    find "$THEMES" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n'
    exit 1
fi

ln -sfn "$THEMES/$THEME" "$THEMES/current"

hyprctl reload >/dev/null 2>&1 || true

# Solo i colori: un reload completo di kitty ricarica anche i font e blocca tutte le finestre
for pid in $(pgrep -x kitty); do
    kitty @ --to "unix:@kitty-$pid" set-colors --all --configured \
        "$THEMES/current/kitty.conf" >/dev/null 2>&1 || true
done

pkill -SIGUSR2 waybar 2>/dev/null || true
makoctl reload 2>/dev/null || true

# Brave: colore della barra via policy (helper installato da _setup/brave).
# Chiaro/scuro lo segue già da gsettings color-scheme, qui sotto.
brave_color=$(sed -n 's/^background *= *"\(#[0-9a-fA-F]\{6\}\)".*/\1/p' "$THEMES/current/palette.toml")
if [ -n "$brave_color" ] && sudo -n /usr/local/libexec/brave-theme-color "$brave_color" 2>/dev/null; then
    if pgrep -x brave >/dev/null; then
        brave-browser --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &
    fi
fi
# Path risolto: con il symlink "current" il path non cambia e hyprpaper non ricarica
hyprctl hyprpaper wallpaper ",$(readlink -f "$THEMES/current/wallpaper.png")" >/dev/null 2>&1 || true

# Reload theme in all running Neovim instances (in parallelo, senza bloccare lo script)
for socket in "$HOME"/.cache/nvim/sockets/*.sock; do
    [ -S "$socket" ] || continue

    (
        if ! nvim --server "$socket" \
            --remote-expr 'execute("lua dofile(vim.fn.expand(\"~/.config/themes/current/nvim.lua\"))")' \
            >/dev/null 2>&1; then
            rm -f "$socket"
        fi
    ) &
done

mode=$(cat "$THEMES/current/mode")

case "$mode" in
    dark)
        gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
        ;;
    light)
        gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita'
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
        ;;
esac
